<!DOCTYPE html>
<html lang="{{ lang }}"{% if dir == 'rtl' %} dir="rtl"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>(function(){try{var t=localStorage.getItem('suu-theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}})();</script>

    <!-- ÜRETİLMİŞ DOSYA — elle düzenlemeyin.
         Kaynak: {{ source_rel }} + content/compare/_template.html.j2
         Yeniden üret: python3 scripts/build-compare.py --apply -->

    <title>{{ meta.title }}</title>
    <meta name="description" content="{{ meta.description }}">
    <meta name="keywords" content="{{ meta.keywords }}">
    <meta name="apple-itunes-app" content="app-id={{ facts.links.app_store_id }}">

    <link rel="canonical" href="{{ url }}">
    <!-- Hreflang cluster (auto-injected) -->
{%- for h in hreflang %}
    <link rel="alternate" hreflang="{{ h.code }}" href="{{ h.href }}">
{%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ xdefault_href }}">


    <meta property="og:title" content="{{ meta.og_title }}">
    <meta property="og:description" content="{{ meta.og_description }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="{{ og_image_url }}">
    <meta property="og:site_name" content="Suu">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="article:published_time" content="{{ published }}">{% if kind == 'guide' %}
    <meta property="article:modified_time" content="{{ modified_iso }}">{% endif %}
    <meta property="article:author" content="{{ facts.entities.founder.name }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ facts.links.twitter_handle }}">
    <meta name="twitter:title" content="{{ meta.og_title }}">
    <meta name="twitter:description" content="{{ meta.og_description }}">
    <meta name="twitter:image" content="{{ og_image_url }}">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800{% if lang == 'hi' %}&family=Noto+Sans+Devanagari:wght@400;500;600;700;800{% endif %}&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/donation-widget.css?v=6">
    <link rel="stylesheet" href="/assets/css/suu.css">

    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    <script src="/assets/js/analytics.js" defer></script>
    <script src="/lang-switcher.js?v=3" defer></script>
    <script src="/assets/js/theme.js?v=1" defer></script>
    <script src="/donation-widget.js?v=6" defer></script>
</head>
<body>

<a class="skip-link" href="#main">{{ ui.skip }}</a>

<nav class="nav">
    <div class="container nav__inner">
        <a href="{{ ui.home_href }}" class="nav__logo"><img src="/assets/brand/suu-badge-128.png" alt="Suu" width="128" height="128" class="suu-logo-badge" style="height:1.6em;width:1.6em;border-radius:50%;vertical-align:-0.4em;box-shadow:0 0 0 1px rgba(255,255,255,.12),0 0 14px rgba(94,170,255,.45);"> Suu</a>
        <ul class="nav__links">
            <li><a href="{{ ui.blog_href }}">{{ ui.blog }}</a></li>
            {% if kind != 'guide' %}<li><a href="{{ ui.home_href }}#karsilastirma">{{ ui.compare }}</a></li>{% endif %}
            <li><a href="{{ ui.home_href }}#fiyat">{{ ui.pricing }}</a></li>
        </ul>
        <div class="nav__actions">
            <a href="/app?src={{ 'guide-nav' if kind == 'guide' else 'compare-nav' }}" class="btn btn--primary" data-cta="nav"
               style="min-height:40px;padding:var(--sp-2) var(--sp-5);font-size:var(--fs-sm)">{{ ui.cta }}</a>
        </div>
    </div>
</nav>

<main id="main">

<header class="section" style="padding-block-end:var(--sp-8)">
    <div class="container container--narrow">
        {#- Görünür breadcrumb: BreadcrumbList şeması vardı ama DOM'da karşılığı
            yoktu. Google yapılandırılmış verinin görünür içerikle eşleşmesini
            istiyor; ayrıca gezinme bağlantısı iç bağlantı grafiğini besliyor. #}
        <nav class="breadcrumb small text-subtle" aria-label="Breadcrumb"
             style="margin-block-end:var(--sp-4)">
            <a href="{{ ui.home_href }}">Suu</a>
            <span aria-hidden="true"> › </span>
            <a href="{{ ui.blog_href }}">{{ ui.blog }}</a>
            <span aria-hidden="true"> › </span>
            <span aria-current="page">{{ h1 }}</span>
        </nav>
        <span class="badge badge--new">{{ badge }}</span>
        <h1 style="margin-block-start:var(--sp-4)">{{ h1 }}</h1>
        <p class="small text-subtle">{{ ui.published_label }} {{ published_display }}{% if kind == 'guide' and modified_display %} · {{ ui.updated_label }} {{ modified_display }}{% endif %} · {{ facts.entities.founder.name }} · {{ read_minutes }} {{ ui.read_time }}</p>
    </div>
</header>

<div class="container container--narrow stack--lg" style="padding-block-end:var(--sp-24)">

    <!-- CEVAP-ÖNCE: alıntılanan blok burasıdır -->
    <div class="answer-box">
        <p><strong>{{ ui.short_answer }}</strong> {{ answer }}</p>
    </div>{% if health_note is defined %}

    {#- Sağlık notu: rehberler sağlık sorusu cevaplıyor. "Tıbbi tavsiye değildir,
        bir sağlık uzmanına danış" + konuya özel "hemen doktora" durumları.
        Cevabın hemen altında — okur ilk ekranda görsün (Play Sağlık İçerikleri
        politikasıyla aynı ilke; check-facts → guide-health-note). #}
    <aside class="callout health-note" role="note">
        <p><strong>{{ health_note.head }}</strong></p>
{%- for p in health_note.body %}
        <p>{{ p | safe }}</p>
{%- endfor %}
{%- if health_note.get('red_flags') %}
        <ul>
{%- for li in health_note['red_flags'] %}
            <li>{{ li | safe }}</li>
{%- endfor %}
        </ul>
{%- endif %}
    </aside>{% endif %}

    <div class="disclosure">{{ disclosure }}</div>

{#- Sıralı cevap: "en iyi X uygulaması" sorgularında dil modelinin tek parça
    alıntıladığı blok. Cevap kutusu tek cümlelik cevabı, bu liste sayılmış
    cevabı verir; ikisi birlikte sayfanın üstünü kendi kendine yeten bir
    pasaj yapar. ItemList şeması bu listeden üretilir (build-compare.py). #}
{%- if ranked is defined %}
    <section>
        <h2>{{ ranked.head }}</h2>
{%- if ranked.get('lead') %}
        <p>{{ ranked.lead | safe }}</p>
{%- endif %}
        <ol class="ranked stack">
{%- for item in ranked['items'] %}
            <li>
                <strong>{{ item.name }}</strong>{% if item.get('tag') %} — <em>{{ item.tag }}</em>{% endif %}
                <p>{{ item.body | safe }}</p>
            </li>
{%- endfor %}
        </ol>
    </section>
{%- endif %}

    {%- for section in intro %}
    <p>{{ section | safe }}</p>
    {%- endfor %}

    {% if table is defined %}<section>
        <h2>{{ table.head }}</h2>
        <div class="table-scroll">
            <table class="table">
                <caption class="sr-only">{{ table.caption }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ table.col_feature }}</th>
{%- if table.get('columns') %}
{#- Genel biçim: rakip-vs-rakip sayfalarında Suu sonda üçüncü seçenek olabilir #}
{%- for c in table['columns'] %}
                        <th scope="col"{% if loop.index0 == table.get('suu_col', -1) %} class="col-suu"{% endif %}>{{ c }}</th>
{%- endfor %}
{%- else %}
                        <th scope="col" class="col-suu">Suu</th>
{%- for c in table.competitors %}
                        <th scope="col">{{ c }}</th>
{%- endfor %}
{%- endif %}
                    </tr>
                </thead>
                <tbody>
{%- if table.get('columns') %}
{%- for r in table['rows'] %}
                    <tr><td>{{ r.label }}</td>{% for v in r['cells'] %}<td class="{% if loop.index0 == table.get('suu_col', -1) %}col-suu {% endif %}{{ v.cls }}">{{ v.text }}</td>{% endfor %}</tr>
{%- endfor %}
{%- else %}
{%- for r in table['rows'] %}
                    <tr><td>{{ r.label }}</td><td class="col-suu {{ r.suu_class }}">{{ r.suu }}</td>{% for v in r.others %}<td class="{{ v.cls }}">{{ v.text }}</td>{% endfor %}</tr>
{%- endfor %}
{%- endif %}
                </tbody>
            </table>
        </div>
    </section>{% endif %}

{%- for block in analysis %}
    <section>
        <h2>{{ block.head }}</h2>
{%- for p in block.body %}
        <p>{{ p | safe }}</p>
{%- endfor %}
{%- if block.get('list') %}
        <ul>
{%- for li in block['list'] %}
            <li>{{ li | safe }}</li>
{%- endfor %}
        </ul>
{%- endif %}
{%- if block.get('callout') %}
        <div class="callout"><p>{{ block.callout | safe }}</p></div>
{%- endif %}
    </section>
{%- endfor %}
{#- "Bunu Suu'da nereden takip edersin": rehberin dönüşüm bölümü. Her adım
    gerçek menü etiketiyle (iOS/Android ayrı olabilir) ve neyi çözdüğüyle. #}
{%- if in_app is defined %}

    <section class="in-app" id="in-app">
        <h2>{{ in_app.head }}</h2>
{%- if in_app.get('lead') %}
        <p>{{ in_app.lead | safe }}</p>
{%- endif %}
        <ol class="ranked stack">
{%- for step in in_app.steps %}
            <li>
                <strong>{{ step.feature }}</strong>{% if step.get('premium') %} — <em>Premium</em>{% endif %}
{%- if step.get('where') %}
                <p class="small text-subtle">{{ step.where | safe }}</p>
{%- else %}
                <p class="small text-subtle"><bdi>iPhone</bdi>: {{ step.where_ios | safe }}<br><bdi>Android</bdi>: {{ step.where_android | safe }}</p>
{%- endif %}
                <p>{{ step.solves | safe }}</p>
            </li>
{%- endfor %}
        </ol>
{%- if in_app.get('note') %}
        <p class="small text-subtle">{{ in_app.note | safe }}</p>
{%- endif %}
        <div class="btn-row" style="margin-block-start:var(--sp-4)">
            <a href="/app?src=guide-inapp-{{ topic }}" class="btn btn--primary" data-cta="guide-inapp">{{ in_app.button }}</a>
        </div>
    </section>
{%- endif %}

    <section class="verdict">
        <h2 style="margin-block-end:var(--sp-4)">{{ verdict.head }}</h2>
{%- for p in verdict.body %}
        <p>{{ p | safe }}</p>
{%- endfor %}
    </section>

    <section class="cta-band" style="border-radius:var(--r-lg);padding-block:var(--sp-12)" data-cta="{{ 'guide-body' if kind == 'guide' else 'compare-body' }}">
        <div class="container">
            <h2 style="font-size:var(--fs-2xl)">{{ cta.head }}</h2>
            <p>{{ cta.sub }}</p>
            <div class="btn-row btn-row--center" style="margin-block-start:var(--sp-6)">
                <a href="/app?src={{ cta_src }}" class="btn btn--secondary btn--lg">{{ cta.button }}</a>
            </div>
        </div>
    </section>

    <section>
        <h2>{{ ui.faq_head }}</h2>
        <div class="faq">
{%- for item in faq %}
            <details class="faq__item"{% if loop.first %} open{% endif %}>
                <summary>{{ item.q }}</summary>
                <div><p>{{ item.a }}</p></div>
            </details>
{%- endfor %}
        </div>
    </section>

{%- if references %}
    <section>
        <h2>{{ ui.references }}</h2>
        <ol class="small">
{%- for ref in references %}
            <li id="ref{{ loop.index }}"><a href="{{ ref.href }}" rel="nofollow noopener" target="_blank">{{ ref.label }}</a></li>
{%- endfor %}
        </ol>
    </section>
{%- endif %}

    <section>
        <h2>{{ ui.related }}</h2>
        <div class="cards">
{%- for r in related %}
            <a class="card" href="{{ r.href }}">
                <h3 style="font-size:var(--fs-md)">{{ r.title }}</h3>
                <p>{{ r.desc }}</p>
            </a>
{%- endfor %}
        </div>
    </section>

    <p class="small text-subtle">{{ facts.medical_disclaimer[lang] if lang in facts.medical_disclaimer else facts.medical_disclaimer['en'] }}</p>

    <p>
        <a href="{{ ui.blog_href }}">← {{ ui.back_to_blog }}</a>
{%- if ui.get('hub_href') and kind != 'guide' %}
        &nbsp;·&nbsp; <a href="{{ ui.hub_href }}">{{ ui.hub_label }} →</a>
{%- endif %}
    </p>
</div>

</main>

<footer class="footer">
    <div class="container">
        <div class="footer__bottom" style="border:0">
            <p class="small mb-0">© 2026 Suu · {{ facts.entities.founder.name }}</p>
            <p class="small mb-0"><a href="{{ ui.home_href }}">suuapp.com</a></p>
        </div>
    </div>
</footer>

<div class="sticky-cta" data-cta="sticky">
    <a href="/app?src=sticky" class="btn btn--secondary">App Store</a>
    <a href="/app?src=sticky" class="btn btn--primary">Google Play</a>
</div>

<script src="/assets/js/suu-badge.js?v=2" defer></script>
</body>
</html>
