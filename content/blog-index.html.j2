{% macro card(p, eager=False) -%}
            <article class="bi-card" style="--c:{{ p.color }};--bg-c:{{ p.bg }}">
                <a href="{{ p.href }}">
                    <div class="bi-thumb">{% if p.thumb %}<img src="{{ p.thumb }}" alt="" width="600" height="315" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">{% endif %}</div>
                    <div class="bi-body">
                        <span class="bi-tag">{{ p.emoji }} {{ p.cat_label }}</span>
                        <h3>{{ p.title }}</h3>
                        <p>{{ p.excerpt }}</p>
                        <div class="bi-meta"><time datetime="{{ p.date_iso }}">{{ p.date_display }}</time><span aria-hidden="true">·</span><span>{{ p.read }}</span></div>
                    </div>
                </a>
            </article>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{% if dir == 'rtl' %} dir="rtl"{% endif %}>
<head>
    {{ marker|safe }}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ c.title }}</title>
    <meta name="description" content="{{ c.description }}">

    <!-- Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6757619920">

    <link rel="canonical" href="{{ url }}">

    <link rel="alternate" type="text/plain" href="{{ llms }}" title="Suu — compact reference for AI assistants">
    <link rel="alternate" type="text/plain" href="{{ llms_full }}" title="Suu — full reference corpus for AI assistants">
    <link rel="alternate" type="application/rss+xml" title="{{ feed_title }}" href="/{{ feed }}">

    <meta property="og:title" content="{{ c.title }}">
    <meta property="og:description" content="{{ c.og_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://suuapp.com/assets/og-image.png">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:site_name" content="Suu">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@SuuTakip">
    <meta name="twitter:title" content="{{ c.title }}">
    <meta name="twitter:description" content="{{ c.og_description }}">
    <meta name="twitter:image" content="https://suuapp.com/assets/og-image.png">

    <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; img-src 'self' https: data:; font-src 'self' https: data:;">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root { --ink:#111827; --ink-2:#374151; --muted:#6b7280; --line:#e5e9f0; --bg:#f5f7fb; --card:#fff; --brand:#4A90D9; --brand-2:#29B6F6; --nav-h:64px; }
        * { margin:0; padding:0; box-sizing:border-box; }
        [hidden] { display:none !important; }
        html { scroll-behavior:smooth; }
        body { font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color:var(--ink-2); background:var(--bg); line-height:1.55; -webkit-font-smoothing:antialiased; }
        a { color:inherit; }

        /* Nav */
        .blog-nav { background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:100; }
        .nav-content { max-width:1180px; margin:0 auto; padding:0 20px; height:var(--nav-h); display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .blog-logo { display:flex; align-items:center; gap:8px; font-size:1.35rem; font-weight:800; color:var(--brand); text-decoration:none; flex:none; }
        .nav-right { display:flex; align-items:center; gap:8px; min-width:0; }
        .nav-btn { display:inline-flex; align-items:center; gap:7px; padding:8px 12px; border-radius:10px; text-decoration:none; font-size:14px; font-weight:600; color:var(--ink-2); white-space:nowrap; transition:background .15s, color .15s; }
        .nav-btn:hover { background:#eef4fc; color:var(--brand); }
        .nav-btn i { color:var(--brand); font-size:13px; }

        /* Hero */
        .bi-hero { background:radial-gradient(1200px 400px at 85% -10%, rgba(255,255,255,.18), transparent 60%), linear-gradient(135deg,#2f6fd0 0%,var(--brand) 45%,var(--brand-2) 100%); color:#fff; padding:52px 20px 40px; }
        .bi-hero-in { max-width:820px; margin:0 auto; text-align:center; }
        .bi-hero h1 { font-size:clamp(2rem,5vw,2.9rem); font-weight:800; letter-spacing:-.02em; line-height:1.1; }
        .bi-lead { margin:12px auto 0; max-width:640px; font-size:clamp(1rem,2.2vw,1.12rem); opacity:.95; }
        .bi-search { position:relative; margin:26px auto 0; max-width:620px; }
        .bi-search input { width:100%; height:56px; border:0; border-radius:16px; padding:0 52px; font:inherit; font-size:16px; color:var(--ink); background:#fff; box-shadow:0 12px 32px rgba(10,40,90,.22); }
        .bi-search input:focus { outline:3px solid rgba(255,255,255,.75); outline-offset:3px; }
        .bi-search .bi-ico { position:absolute; inset-inline-start:19px; top:50%; transform:translateY(-50%); color:#9aa6b8; font-size:17px; pointer-events:none; }
        .bi-search button { position:absolute; inset-inline-end:10px; top:50%; transform:translateY(-50%); width:36px; height:36px; border:0; border-radius:10px; background:#f1f4f9; color:var(--muted); cursor:pointer; font-size:15px; }
        .bi-stats { list-style:none; display:flex; flex-wrap:wrap; justify-content:center; gap:8px 22px; margin-top:20px; font-size:14px; opacity:.95; }
        .bi-stats strong { font-weight:800; }
        .bi-stats li { display:inline-flex; align-items:center; gap:6px; }

        /* Category bar */
        .bi-chips { position:sticky; top:var(--nav-h); z-index:90; background:rgba(255,255,255,.96); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border-bottom:1px solid var(--line); }
        .bi-chips-in { max-width:1180px; margin:0 auto; padding:10px 20px; display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; }
        .bi-chips-in::-webkit-scrollbar { display:none; }
        .bi-chip { --c:var(--ink); flex:none; display:inline-flex; align-items:center; gap:7px; padding:8px 14px; border-radius:999px; border:1px solid var(--line); background:#fff; color:var(--ink-2); text-decoration:none; font-size:14px; font-weight:600; white-space:nowrap; transition:background .15s, border-color .15s, color .15s; }
        .bi-chip:hover { border-color:var(--c); color:var(--c); }
        .bi-chip .n { font-size:12px; font-weight:700; color:var(--muted); background:#f1f4f9; border-radius:999px; padding:1px 8px; }
        .bi-chip[aria-current="true"] { background:var(--c); border-color:var(--c); color:#fff; }
        .bi-chip[aria-current="true"] .n { background:rgba(255,255,255,.22); color:#fff; }

        /* Layout */
        .bi-main { max-width:1180px; margin:0 auto; padding:30px 20px 72px; }
        .bi-status { font-size:14px; font-weight:600; color:var(--muted); margin-bottom:6px; }
        .bi-status:empty { display:none; }
        .bi-sec { margin-top:34px; scroll-margin-top:calc(var(--nav-h) + 70px); }
        .bi-main > .bi-sec:first-of-type, .bi-status + .bi-sec:not([hidden]) { margin-top:0; }
        .bi-sec-head { display:flex; align-items:flex-start; gap:14px; margin-bottom:18px; }
        .bi-sec-ico { flex:none; width:46px; height:46px; border-radius:14px; display:grid; place-items:center; font-size:22px; background:var(--bg-c,#eef4fc); }
        .bi-sec-head h2 { font-size:clamp(1.25rem,2.6vw,1.5rem); font-weight:800; color:var(--ink); letter-spacing:-.01em; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
        .bi-sec-head h2 .n { font-size:13px; font-weight:700; color:var(--c,#4A90D9); background:var(--bg-c,#eef4fc); border-radius:999px; padding:2px 10px; }
        .bi-sec-head p { color:var(--muted); font-size:.95rem; margin-top:3px; }
        .bi-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:22px; }
        .bi-latest .bi-grid { grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); }

        /* Card */
        .bi-card { background:var(--card); border:1px solid var(--line); border-radius:18px; overflow:hidden; transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
        .bi-card:hover { transform:translateY(-3px); box-shadow:0 14px 34px rgba(17,24,39,.10); border-color:#d6deea; }
        .bi-card a { display:flex; flex-direction:column; height:100%; text-decoration:none; color:inherit; }
        .bi-card a:focus-visible { outline:3px solid var(--brand); outline-offset:-3px; border-radius:18px; }
        .bi-thumb { aspect-ratio:1200/630; background:var(--bg-c,#eef4fc); overflow:hidden; }
        .bi-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
        .bi-body { padding:15px 18px 18px; display:flex; flex-direction:column; gap:7px; flex:1; }
        .bi-tag { align-self:flex-start; font-size:11.5px; font-weight:700; color:var(--c,#4A90D9); background:var(--bg-c,#eef4fc); border-radius:999px; padding:3px 10px; }
        .bi-card h3 { font-size:1.02rem; line-height:1.4; font-weight:700; color:var(--ink); display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
        .bi-card p { font-size:.9rem; color:var(--muted); display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
        .bi-meta { margin-top:auto; padding-top:6px; font-size:.8rem; color:#8a94a6; display:flex; flex-wrap:wrap; gap:4px 10px; }

        /* Empty + CTA + footer */
        .bi-empty { text-align:center; padding:56px 20px; color:var(--muted); }
        .bi-empty p { font-size:1.05rem; margin-bottom:14px; }
        .bi-empty button { border:1px solid var(--line); background:#fff; border-radius:12px; padding:10px 18px; font:inherit; font-weight:600; color:var(--brand); cursor:pointer; }
        .cta-banner { background:linear-gradient(135deg,var(--brand),var(--brand-2)); color:#fff; border-radius:22px; padding:38px 24px; text-align:center; margin-top:64px; }
        .cta-banner h2 { font-size:clamp(1.3rem,3vw,1.6rem); font-weight:800; margin-bottom:8px; }
        .cta-banner p { opacity:.95; margin-bottom:22px; }
        .cta-btns { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
        .cta-btn { background:#fff; color:var(--brand); padding:11px 24px; border-radius:50px; font-weight:700; text-decoration:none; font-size:14px; display:inline-flex; align-items:center; gap:8px; transition:transform .15s; }
        .cta-btn:hover { transform:translateY(-2px); }
        .bi-foot { border-top:1px solid var(--line); background:#fff; }
        .bi-foot-in { max-width:1180px; margin:0 auto; padding:24px 20px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px 20px; font-size:14px; color:var(--muted); }
        .bi-foot nav { display:flex; flex-wrap:wrap; gap:8px 18px; }
        .bi-foot a { text-decoration:none; color:var(--ink-2); }
        .bi-foot a:hover { color:var(--brand); }

        /* Sticky mobile download bar (styles.css is not loaded on blog pages) */
        .sticky-download-bar { display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; background:rgba(255,255,255,.97); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); padding:10px 12px; padding-bottom:calc(10px + env(safe-area-inset-bottom,0px)); box-shadow:0 -2px 16px rgba(0,0,0,.12); gap:8px; justify-content:center; }
        .sticky-btn { flex:1; display:flex; align-items:center; justify-content:center; gap:8px; padding:13px 14px; border-radius:12px; text-decoration:none; font-weight:600; font-size:14px; min-height:48px; max-width:200px; }
        .sticky-btn-apple { background:#000; color:#fff; }
        .sticky-btn-google { background:#01875f; color:#fff; }

        @media (max-width:768px) {
            .sticky-download-bar { display:flex; }
            body { padding-bottom:72px; }
        }
        @media (max-width:720px) {
            .nav-btn span { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
            .nav-btn { padding:9px; }
            .bi-hero { padding:38px 16px 30px; }
            .bi-main { padding:22px 16px 60px; }
            .bi-chips-in { padding:10px 16px; }
            .bi-grid, .bi-latest .bi-grid { grid-template-columns:1fr; gap:12px; }
            /* Compact list rows on phones: 60 full-width cover images would be an endless scroll */
            .bi-card { border-radius:14px; }
            .bi-card a { flex-direction:row; align-items:flex-start; gap:12px; padding:12px; }
            .bi-thumb { flex:none; width:112px; border-radius:10px; }
            .bi-body { padding:0; gap:5px; min-width:0; }
            .bi-card h3 { font-size:.95rem; }
            .bi-card p { font-size:.84rem; -webkit-line-clamp:2; }
            .bi-meta { padding-top:2px; font-size:.76rem; }
            .bi-latest .bi-card:first-child a { flex-direction:column; padding:0; gap:0; }
            .bi-latest .bi-card:first-child .bi-thumb { width:100%; border-radius:0; }
            .bi-latest .bi-card:first-child .bi-body { padding:14px 16px 16px; gap:7px; }
            .bi-latest .bi-card:first-child h3 { font-size:1.05rem; }
            .bi-sec { margin-top:28px; }
            .bi-sec-head { gap:12px; margin-bottom:14px; }
            .bi-sec-ico { width:40px; height:40px; font-size:19px; border-radius:12px; }
        }
        @media (prefers-reduced-motion:reduce) {
            html { scroll-behavior:auto; }
            .bi-card, .bi-card:hover { transition:none; transform:none; }
        }
    </style>

