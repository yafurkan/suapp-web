<body>

<nav class="blog-nav">
    <div class="nav-content">
        <a href="{{ home }}" class="blog-logo"><img src="/assets/brand/suu-badge-128.png" alt="Suu" width="128" height="128" class="suu-logo-badge" style="height:1.6em;width:1.6em;border-radius:50%;display:block;"> Suu</a>
        <div class="nav-right">
            <span data-lang-slot></span>
{%- for href, icon, label in c.nav %}
            <a href="{{ href }}" class="nav-btn" title="{{ label }}"><i class="fas {{ icon }}" aria-hidden="true"></i><span>{{ label }}</span></a>
{%- endfor %}
        </div>
    </div>
</nav>

<header class="bi-hero">
    <div class="bi-hero-in">
        <h1>{{ c.h1 }}</h1>
        <p class="bi-lead">{{ c.lead }}</p>
        <form class="bi-search" role="search" action="#" onsubmit="return false">
            <i class="fas fa-magnifying-glass bi-ico" aria-hidden="true"></i>
            <input type="search" id="bi-q" placeholder="{{ c.search_ph }}" aria-label="{{ c.search_label }}" autocomplete="off" enterkeyhint="search">
            <button type="button" id="bi-clear" aria-label="{{ c.clear_search }}" hidden><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </form>
        <ul class="bi-stats">
            <li><strong>{{ total }}</strong> {{ posts_word }}</li>
            <li><strong>{{ sections|length }}</strong> {{ cats_word }}</li>
            <li><i class="far fa-clock" aria-hidden="true"></i> {{ c.updated }}: <time datetime="{{ updated_iso }}">{{ updated_display }}</time></li>
        </ul>
    </div>
</header>

<nav class="bi-chips" aria-label="{{ c.categories_label }}">
    <div class="bi-chips-in">
        <a href="#top" class="bi-chip" data-cat="all" aria-current="true">{{ c.all }} <span class="n">{{ total }}</span></a>
{%- for s in sections %}
        <a href="#{{ s.id }}" class="bi-chip" data-cat="{{ s.key }}" style="--c:{{ s.color }}">{{ s.emoji }} {{ s.label }} <span class="n">{{ s.posts|length }}</span></a>
{%- endfor %}
    </div>
</nav>

<main class="bi-main" id="top">
    <p class="bi-status" id="bi-status" role="status" aria-live="polite"></p>

    <section class="bi-sec bi-latest" id="latest" aria-labelledby="latest-h">
        <div class="bi-sec-head">
            <div class="bi-sec-ico" aria-hidden="true">✨</div>
            <div><h2 id="latest-h">{{ c.latest }}</h2></div>
        </div>
        <div class="bi-grid">
{%- for p in latest %}
{{ card(p, eager=loop.first) }}
{%- endfor %}
        </div>
    </section>
{% for s in sections %}
    <section class="bi-sec" id="{{ s.id }}" data-cat="{{ s.key }}" aria-labelledby="{{ s.id }}-h" style="--c:{{ s.color }};--bg-c:{{ s.bg }}">
        <div class="bi-sec-head">
            <div class="bi-sec-ico" aria-hidden="true">{{ s.emoji }}</div>
            <div>
                <h2 id="{{ s.id }}-h">{{ s.label }} <span class="n">{{ s.posts|length }}</span></h2>
                <p>{{ s.desc }}</p>
            </div>
        </div>
        <div class="bi-grid">
{%- for p in s.posts %}
{{ card(p) }}
{%- endfor %}
        </div>
    </section>
{% endfor %}
    <div class="bi-empty" id="bi-empty" hidden>
        <p>{{ c.no_results }}</p>
        <button type="button" id="bi-reset">{{ c.clear_search }}</button>
    </div>

    <div class="cta-banner">
        <h2>{{ c.cta_title }}</h2>
        <p>{{ c.cta_text }}</p>
        <div class="cta-btns">
            <a href="https://apps.apple.com/us/app/suu-su-takip/id6757619920" class="cta-btn" target="_blank" rel="noopener"><i class="fab fa-apple"></i> App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.sutakip.suutakippro" class="cta-btn" target="_blank" rel="noopener"><i class="fab fa-google-play"></i> Google Play</a>
        </div>
    </div>
</main>

<footer class="bi-foot">
    <div class="bi-foot-in">
        <nav aria-label="Suu">
{%- for href, icon, label in c.nav %}
            <a href="{{ href }}">{{ label }}</a>
{%- endfor %}
            <a href="/{{ feed }}">{{ c.rss }}</a>
            <a href="{{ llms }}">{{ c.ai }}</a>
        </nav>
        <span>© 2026 Suu</span>
    </div>
</footer>

<script>
(function () {
    'use strict';
    var LANG = document.documentElement.lang || 'en';
    var q = document.getElementById('bi-q');
    var clearBtn = document.getElementById('bi-clear');
    var status = document.getElementById('bi-status');
    var empty = document.getElementById('bi-empty');
    var latest = document.getElementById('latest');
    var chips = [].slice.call(document.querySelectorAll('.bi-chip'));
    var secs = [].slice.call(document.querySelectorAll('.bi-sec[data-cat]'));
    var RESULTS = {{ results_js|safe }};
    var state = { cat: 'all', q: '' };

    // Case/diacritic-insensitive matching (ı/i, ç/c, ş/s, Arabic hamza/taa marbuta …)
    function norm(s) {
        return (s || '').toLocaleLowerCase(LANG).normalize('NFD')
            .replace(/[̀-ًͯ-ٰٟـ]/g, '')
            .replace(/ı/g, 'i').replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/ё/g, 'е');
    }
    secs.forEach(function (s) {
        // Title + summary only: the category tag would make "coffee" match every drinks card.
        [].forEach.call(s.querySelectorAll('.bi-card'), function (c) {
            c._t = norm(c.querySelector('h3').textContent + ' ' + c.querySelector('p').textContent);
        });
    });

    function apply(scroll) {
        var toks = norm(state.q).split(/\s+/).filter(Boolean);
        var shown = 0;
        secs.forEach(function (s) {
            var catOk = state.cat === 'all' || s.getAttribute('data-cat') === state.cat;
            var n = 0;
            [].forEach.call(s.querySelectorAll('.bi-card'), function (c) {
                var ok = catOk && toks.every(function (t) { return c._t.indexOf(t) !== -1; });
                c.hidden = !ok;
                if (ok) n++;
            });
            s.hidden = n === 0;
            shown += n;
        });
        latest.hidden = state.cat !== 'all' || toks.length > 0;
        empty.hidden = shown > 0;
        clearBtn.hidden = !state.q;
        status.textContent = toks.length ? RESULTS.replace('{n}', shown) : '';
        chips.forEach(function (ch) {
            ch.setAttribute('aria-current', ch.getAttribute('data-cat') === state.cat ? 'true' : 'false');
        });
        if (scroll) {
            var top = document.getElementById('top').getBoundingClientRect().top + window.pageYOffset - 130;
            if (window.pageYOffset > top) window.scrollTo(0, Math.max(0, top));
        }
    }

    chips.forEach(function (ch) {
        ch.addEventListener('click', function (e) {
            e.preventDefault();
            state.cat = ch.getAttribute('data-cat');
            var sec = state.cat === 'all' ? null : document.querySelector('.bi-sec[data-cat="' + state.cat + '"]');
            try { history.replaceState(null, '', sec ? '#' + sec.id : location.pathname); } catch (err) {}
            apply(true);
            ch.scrollIntoView({ block: 'nearest', inline: 'center' });
        });
    });
    q.addEventListener('input', function () { state.q = q.value; apply(false); });
    function reset() { q.value = ''; state.q = ''; state.cat = 'all'; apply(true); q.focus(); }
    clearBtn.addEventListener('click', reset);
    document.getElementById('bi-reset').addEventListener('click', reset);

    // A shared link like blog.html#cat-calories opens that category filtered.
    var h = location.hash.slice(1);
    var target = h && document.querySelector('.bi-sec[data-cat][id="' + h.replace(/"/g, '') + '"]');
    if (target) { state.cat = target.getAttribute('data-cat'); apply(false); }
})();
</script>

