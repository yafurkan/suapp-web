<!DOCTYPE html>
<html lang="{{ lang }}"{% if dir == 'rtl' %} dir="rtl"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ÜRETİLMİŞ DOSYA — elle düzenlemeyin.
         Kaynak: content/home/{{ lang }}.json + content/home/_template.html.j2
         Yeniden üret: python3 scripts/build-homepages.py --apply -->

    <!-- Google Search Console: VERIFIED via Domain property (DNS TXT record). -->
    <!-- Yandex Webmaster: VERIFIED via HTML file (yandex_d8f56999642a8d54.html). -->

    <title>{{ meta.title }}</title>
    <meta name="description" content="{{ meta.description }}">
    <meta name="keywords" content="{{ meta.keywords }}">

    <link rel="canonical" href="{{ url }}">
    <!-- Hreflang cluster (auto-injected) -->
{%- for h in hreflang %}
    <link rel="alternate" hreflang="{{ h.code }}" href="{{ h.href }}">
{%- endfor %}
    {#- x-default hedefi page-registry.json/_xdefault ile aynı olmalı;
       sabit kodlanınca her build inject-hreflang.py'nin işini geri alıyordu. #}
    <link rel="alternate" hreflang="x-default" href="{{ xdefault_href }}">


    <meta name="apple-itunes-app" content="app-id={{ facts.links.app_store_id }}">

    <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; img-src 'self' https: data:; font-src 'self' https: data:;">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

    <!-- Open Graph -->
    <meta property="og:title" content="{{ meta.og_title }}">
    <meta property="og:description" content="{{ meta.og_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://suuapp.com/assets/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ meta.og_image_alt }}">
    <meta property="og:site_name" content="Suu">
    <meta property="og:locale" content="{{ locale }}">
{%- for alt in og_locale_alternates %}
    <meta property="og:locale:alternate" content="{{ alt }}">
{%- endfor %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ facts.links.twitter_handle }}">
    <meta name="twitter:creator" content="{{ facts.links.twitter_handle }}">
    <meta name="twitter:title" content="{{ meta.tw_title }}">
    <meta name="twitter:description" content="{{ meta.tw_description }}">
    <meta name="twitter:image" content="https://suuapp.com/assets/og-image.png">
    <meta name="twitter:image:alt" content="{{ meta.og_image_alt }}">

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {#- Değişken eksen biçimi (scripts/normalize-fonts.py'nin kanonu): sayılan
       ağırlık listesiyle aynı woff2 dosyalarını döndürüyor ama tek istek ve
       tek önbellek anahtarı oluyor. Şablon kanonu üretmezse her build
       normalize-fonts.py'nin işini geri alır. #}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..900{% if lang == 'hi' %}&family=Noto+Sans+Devanagari:wght@400..800{% endif %}{% if dir == 'rtl' %}&family=Noto+Sans+Arabic:wght@300..800{% endif %}&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/donation-widget.css">
    <link rel="stylesheet" href="/assets/css/suu.css">

    <!-- Yapılandırılmış veri — kaynak: content/suu-facts.json -->
    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    <script src="/assets/js/analytics.js" defer></script>
    <script src="/assets/js/screenshots.js" defer></script>
    <script src="/assets/js/water-calc.js" defer></script>
    <script src="/lang-switcher.js?v=3" defer></script>
    <script src="/donation-widget.js" defer></script>
</head>
<body>

<a class="skip-link" href="#main">{{ nav.skip }}</a>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-water" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s6.5 7 6.5 11.2A6.5 6.5 0 0 1 12 20.2a6.5 6.5 0 0 1-6.5-6.5C5.5 9.5 12 2.5 12 2.5z"/></symbol>
    <symbol id="i-flame" viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 1.7c.4 3-1.3 4.4-2.6 5.7-1.3 1.3-2.5 2.6-2.5 5A5.7 5.7 0 0 0 12 18a3.1 3.1 0 0 1-.9-2.2c0-1.3.8-2.2 1.7-3.2.7-.8 1.5-1.6 1.9-2.8.9 1 1.5 2.2 1.8 3.2a8 8 0 0 1 .3 2.1c0 1-.4 2-1 2.8a5.9 5.9 0 0 0 3.4-5.3c0-4.6-3.6-8.3-5.8-10.9z"/></symbol>
    <symbol id="i-run" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM12.9 7.2 9.4 9l-1.6 4-2.6-.7L4.6 15l4.6 1.3 1.2-3 2 1.6-1.1 6.1h2.4l1.3-7-2.3-2 .8-3.4 1.6 2.2 3.5.9.5-2.3-2.4-.6-1.9-2.6a2.5 2.5 0 0 0-2-1z"/></symbol>
    <symbol id="i-camera" viewBox="0 0 24 24" fill="currentColor"><path d="M9.5 3.5 8.2 5.5H4.5A2.5 2.5 0 0 0 2 8v10a2.5 2.5 0 0 0 2.5 2.5h15A2.5 2.5 0 0 0 22 18V8a2.5 2.5 0 0 0-2.5-2.5h-3.7l-1.3-2h-5zM12 17.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6z"/></symbol>
    <symbol id="i-chat" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5c-5.5 0-10 3.6-10 8 0 2.5 1.4 4.7 3.6 6.2L4.4 21l4.5-2.2c1 .2 2 .4 3.1.4 5.5 0 10-3.6 10-8s-4.5-8.7-10-8.7z"/></symbol>
    <symbol id="i-apple" viewBox="0 0 24 24" fill="currentColor"><path d="M17.56 12.3c-.03-3.06 2.5-4.53 2.61-4.6-1.42-2.08-3.63-2.37-4.42-2.4-1.88-.19-3.67 1.11-4.63 1.11-.95 0-2.42-1.08-3.98-1.05-2.05.03-3.94 1.19-4.99 3.03-2.13 3.69-.54 9.15 1.53 12.14 1.01 1.46 2.21 3.1 3.79 3.04 1.52-.06 2.09-.98 3.93-.98 1.83 0 2.36.98 3.97.95 1.64-.03 2.68-1.49 3.68-2.96 1.16-1.7 1.64-3.35 1.67-3.43-.04-.02-3.2-1.23-3.23-4.87M14.5 3.7c.84-1.02 1.4-2.43 1.25-3.84-1.21.05-2.67.81-3.53 1.82-.77.9-1.45 2.34-1.27 3.72 1.35.1 2.72-.69 3.55-1.7"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
</svg>

{%- macro store_buttons(src) %}
<div class="btn-row{% if src == 'kapanis' %} btn-row--center{% endif %}">
    <a href="/app?src={{ src }}" class="btn-store" aria-label="{{ hero.aria_app_store }}">
        <span class="btn-store__icon"><svg width="22" height="22" aria-hidden="true"><use href="#i-apple"></use></svg></span>
        <span class="btn-store__label">
            <span class="btn-store__small">{{ hero.store_small }}</span>
            <span class="btn-store__big">App Store</span>
        </span>
    </a>
    <a href="/app?src={{ src }}" class="btn-store" aria-label="{{ hero.aria_google_play }}">
        <span class="btn-store__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24">
                <path fill="#00D2FF" d="M3.6 1.8A1.5 1.5 0 0 0 3 3v18c0 .5.2.9.6 1.2l.1.1 10.1-10.1v-.3L3.7 1.7l-.1.1z"/>
                <path fill="#FFCE00" d="M17.2 15.6l-3.4-3.4v-.3l3.4-3.4.1.1 4 2.3c1.2.6 1.2 1.7 0 2.4l-4 2.3z"/>
                <path fill="#FF3A44" d="M17.3 15.5 13.8 12 3.6 22.2c.4.4 1 .5 1.8.1l11.9-6.8"/>
                <path fill="#00E676" d="M17.3 8.5 5.4 1.7c-.8-.4-1.4-.4-1.8.1L13.8 12l3.5-3.5z"/>
            </svg>
        </span>
        <span class="btn-store__label">
            <span class="btn-store__small">{{ hero.store_small }}</span>
            <span class="btn-store__big">Google Play</span>
        </span>
    </a>
</div>
{%- endmacro %}

<nav class="nav" id="nav">
    <div class="container nav__inner">
        <a href="{{ links.home }}" class="nav__logo" aria-label="{{ nav.home_aria }}">
            <svg width="26" height="26" aria-hidden="true"><use href="#i-water"></use></svg>
            Suu
        </a>
        <ul class="nav__links" id="navLinks">
{%- for item in nav.links %}
            <li><a href="{{ item.href }}">{{ item.label }}</a></li>
{%- endfor %}
        </ul>
        <div class="nav__actions">
            <a href="/app?src=nav" class="btn btn--primary" data-cta="nav" style="min-height:40px;padding:var(--sp-2) var(--sp-5);font-size:var(--fs-sm)">{{ nav.cta }}</a>
        </div>
        <button class="nav__toggle" id="navToggle" aria-label="{{ nav.menu_open }}" aria-expanded="false" aria-controls="navLinks">
            <svg width="24" height="24" aria-hidden="true"><use href="#i-menu"></use></svg>
        </button>
    </div>
</nav>

<main id="main">

<!-- HERO -->
<section class="hero" data-cta="hero">
    <div class="container hero__grid">
        <div>
            <span class="eyebrow">{{ hero.eyebrow }}</span>
            <h1 class="hero__title">{{ hero.title_lead }} <span class="accent">{{ hero.title_accent }}</span></h1>
            <p class="hero__lead">{{ hero.lead }}</p>
            {{ store_buttons('hero') }}
            <p class="small text-subtle" style="margin-block-start:var(--sp-4)">{{ hero.trial_note | safe }}</p>
            <div class="trust-row">
                <span class="trust-row__item">
                    <span class="trust-row__stars" aria-hidden="true">★★★★★</span>
                    <span>{{ hero.trust_rating }}</span>
                </span>
                <span class="trust-row__item">{{ hero.trust_reviews }}</span>
                <span class="trust-row__item">{{ hero.trust_health }}</span>
                <span class="trust-row__item">{{ hero.trust_langs }}</span>
{%- if hero.trust_track %}
                <span class="trust-row__item">{{ hero.trust_track }}</span>
{%- endif %}
            </div>
        </div>
        <div class="hero__media">
            <div class="phone phone--lg">
                <img src="{{ shot('ios', lang, 'ana-ekran') }}"
                     data-screen="ana-ekran" data-platform="ios"
                     width="585" height="1266" fetchpriority="high"
                     alt="{{ hero.shot_alt }}">
            </div>
        </div>
    </div>
</section>

<!-- ÜÇ SÜTUN -->
<section class="section section--subtle" id="pillars">
    <div class="container">
        <div class="section-head">
            <h2>{{ pillars.head }}</h2>
            <p>{{ pillars.sub }}</p>
        </div>
        <div class="pillars">
{%- for p in pillars['items'] %}
            <article class="pillar pillar--{{ p.id }}">
                <span class="pillar__icon"><svg width="26" height="26" aria-hidden="true"><use href="#i-{{ p.icon }}"></use></svg></span>
                <h3>{{ p.title }}</h3>
                <p>{{ p.body | safe }}</p>
                <p style="margin-block-start:var(--sp-3)"><a href="{{ p.link_href }}">{{ p.link_label }} <span class="arrow" aria-hidden="true">→</span></a></p>
            </article>
{%- endfor %}
        </div>
        <div class="answer-box" style="margin-block-start:var(--sp-10)">
            <p><strong>{{ pillars.answer_label }}</strong> {{ pillars.answer }}</p>
        </div>
    </div>
</section>

<!-- KALORİ -->
<section class="section" id="kalori" data-cta="kalori">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">{{ calories.eyebrow }}</span>
            <h2>{{ calories.head }}</h2>
            <p>{{ calories.sub }}</p>
        </div>
        <div class="cards">
{%- for c in calories['items'] %}
            <article class="card">
                <div class="card__icon" style="color:var(--pillar-calories)">{% if c.get('icon') %}<svg width="30" height="30" aria-hidden="true"><use href="#i-{{ c.icon }}"></use></svg>{% else %}{{ c.get('emoji', '') }}{% endif %}</div>
                <h3>{{ c.title }}</h3>
                <p>{{ c.body }}</p>
            </article>
{%- endfor %}
        </div>
        <div class="callout" style="margin-block-start:var(--sp-8)">
            <p>{{ calories.callout | safe }}</p>
        </div>
    </div>
</section>

<!-- SUU AI -->
<section class="section section--subtle" id="suu-ai">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Suu AI</span>
            <h2>{{ suu_ai.head }}</h2>
            <p>{{ suu_ai.sub }}</p>
        </div>
        <div class="cards">
{%- for c in suu_ai['items'] %}
            <article class="card">
                <div class="card__icon" style="color:var(--pillar-water)">{% if c.get('icon') %}<svg width="30" height="30" aria-hidden="true"><use href="#i-{{ c.icon }}"></use></svg>{% else %}{{ c.get('emoji', '') }}{% endif %}</div>
                <h3>{{ c.title }}</h3>
                <p>{{ c.body }}</p>
            </article>
{%- endfor %}
        </div>
    </div>
</section>

<!-- EGZERSİZ -->
<section class="section" id="egzersiz">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">{{ exercise.eyebrow }}</span>
            <h2>{{ exercise.head }}</h2>
            <p>{{ exercise.sub }}</p>
        </div>
        <div class="cards">
{%- for c in exercise['items'] %}
            <article class="card">
                <div class="card__icon" style="color:var(--pillar-exercise)">{% if c.get('icon') %}<svg width="30" height="30" aria-hidden="true"><use href="#i-{{ c.icon }}"></use></svg>{% else %}{{ c.get('emoji', '') }}{% endif %}</div>
                <h3>{{ c.title }}</h3>
                <p>{{ c.body }}</p>
{%- if c.get('metrics') %}
                <div class="metrics">
{%- for m in c.get('metrics') %}
                    <span class="metric"><span class="metric__label">{{ m }}</span></span>
{%- endfor %}
                </div>
{%- endif %}
            </article>
{%- endfor %}
        </div>
    </div>
</section>

<!-- SU HEDEFİ + HESAPLAYICI -->
<section class="section section--subtle" id="su-hedefi">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">{{ water.eyebrow }}</span>
            <h2>{{ water.head }}</h2>
            <p>{{ water.sub }}</p>
        </div>
        <div class="cards" style="margin-block-end:var(--sp-10)">
{%- for c in water['items'] %}
            <article class="card">
                <h3>{{ c.title }}</h3>
                <p>{{ c.body | safe }}</p>
            </article>
{%- endfor %}
        </div>

        <div class="card" style="max-width:44rem;margin-inline:auto">
            <h3>{{ water.calc.head }}</h3>
            <p class="small">{{ water.calc.note }}</p>
            <form data-water-calc style="margin-block-start:var(--sp-5)">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:var(--sp-4)">
                    <label style="display:block">
                        <span class="small" style="display:block;margin-block-end:var(--sp-2);font-weight:600">{{ water.calc.age }}</span>
                        <input type="number" name="age" min="10" max="110" required placeholder="28"
                               style="width:100%;min-height:46px;padding:0 var(--sp-3);border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg);color:var(--text);font:inherit">
                    </label>
                    <label style="display:block">
                        <span class="small" style="display:block;margin-block-end:var(--sp-2);font-weight:600">{{ water.calc.weight }}</span>
                        <input type="number" name="weight" min="25" max="300" required placeholder="72"
                               style="width:100%;min-height:46px;padding:0 var(--sp-3);border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg);color:var(--text);font:inherit">
                    </label>
                    <label style="display:block">
                        <span class="small" style="display:block;margin-block-end:var(--sp-2);font-weight:600">{{ water.calc.gender }}</span>
                        <select name="gender" style="width:100%;min-height:46px;padding:0 var(--sp-3);border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg);color:var(--text);font:inherit">
                            <option value="female">{{ water.calc.female }}</option>
                            <option value="male">{{ water.calc.male }}</option>
                        </select>
                    </label>
                    <label style="display:block">
                        <span class="small" style="display:block;margin-block-end:var(--sp-2);font-weight:600">{{ water.calc.activity }}</span>
                        <select name="activity" style="width:100%;min-height:46px;padding:0 var(--sp-3);border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg);color:var(--text);font:inherit">
                            <option value="sedentary">{{ water.calc.act_sedentary }}</option>
                            <option value="light">{{ water.calc.act_light }}</option>
                            <option value="moderate" selected>{{ water.calc.act_moderate }}</option>
                            <option value="active">{{ water.calc.act_active }}</option>
                            <option value="extra">{{ water.calc.act_extra }}</option>
                        </select>
                    </label>
                </div>
                <button type="submit" class="btn btn--primary btn--block" style="margin-block-start:var(--sp-5)">{{ water.calc.submit }}</button>
                <div data-calc-result hidden style="margin-block-start:var(--sp-6);padding:var(--sp-5);border-radius:var(--r-md);background:var(--pillar-water-soft);text-align:center">
                    <p style="margin:0;font-size:var(--fs-2xl);font-weight:800;color:var(--text)"><span data-calc-liters>—</span> {{ water.calc.liters }}</p>
                    <p class="small" style="margin-block-start:var(--sp-2)">{{ water.calc.cups_prefix }} <span data-calc-cups>—</span> {{ water.calc.cups_suffix }}</p>
                    <a href="/app?src=calculator" class="btn btn--primary" style="margin-block-start:var(--sp-4)">{{ water.calc.cta }}</a>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- EKRAN GÖRÜNTÜLERİ -->
<section class="section" id="ekranlar">
    <div class="container">
        <div class="section-head">
            <h2>{{ shots.head }}</h2>
            <p>{{ shots.sub }}</p>
        </div>
        <div class="shots" data-shots>
            <div style="display:flex;justify-content:center">
                <div class="shots__tabs" role="tablist" aria-label="{{ shots.tablist_label }}">
                    <button class="shots__tab" role="tab" id="tab-ios" aria-controls="shots-ios" aria-selected="true" data-platform="ios">
                        <svg width="16" height="16" aria-hidden="true"><use href="#i-apple"></use></svg> iOS
                    </button>
                    <button class="shots__tab" role="tab" id="tab-android" aria-controls="shots-android" aria-selected="false" data-platform="android">Android</button>
                </div>
            </div>
{%- for platform in ['ios', 'android'] %}
            <div class="shots__panel" id="shots-{{ platform }}" role="tabpanel" aria-labelledby="tab-{{ platform }}"{% if platform == 'android' %} hidden{% endif %}>
                <div class="shots__strip">
{%- for s in shots['items'] %}
                    <figure class="shots__item">
                        <div class="phone"><img src="{{ shot(platform, lang, s.slug) }}" data-screen="{{ s.slug }}" data-platform="{{ platform }}" loading="lazy" width="585" height="1266" alt="{{ platform | replace('ios', 'iOS') | replace('android', 'Android') }} — {{ s.caption }}"></div>
                        <figcaption>{{ s.caption }}</figcaption>
                    </figure>
{%- endfor %}
                </div>
            </div>
{%- endfor %}
        </div>
    </div>
</section>

<!-- OYUNLAŞTIRMA -->
<section class="section section--subtle" id="sosyal">
    <div class="container">
        <div class="section-head"><h2>{{ social.head }}</h2></div>
        <div class="cards">
{%- for c in social['items'] %}
            <article class="card">
                <div class="card__icon">{{ c.get('emoji', '') }}</div>
                <h3>{{ c.title }}</h3>
                <p>{{ c.body | safe }}</p>
            </article>
{%- endfor %}
        </div>
    </div>
</section>

<!-- PLATFORM MATRİSİ -->
<section class="section" id="platform">
    <div class="container">
        <div class="section-head">
            <h2>{{ platform.head }}</h2>
            <p>{{ platform.sub }}</p>
        </div>
        <div class="table-scroll">
            <table class="table">
                <caption class="sr-only">{{ platform.caption }}</caption>
                <thead><tr><th scope="col">{{ platform.col_feature }}</th><th scope="col">iOS</th><th scope="col">Android</th></tr></thead>
                <tbody>
{%- for r in platform.rows %}
                    <tr><td>{{ r.label }}</td>{% for v in [r.ios, r.android] %}<td class="{{ 'yes' if v == 'yes' else ('soon' if v == 'soon' else 'no') }}">{{ platform.yes if v == 'yes' else (platform.soon if v == 'soon' else '—') }}</td>{% endfor %}</tr>
{%- endfor %}
                </tbody>
            </table>
        </div>
        <p class="small text-subtle" style="margin-block-start:var(--sp-4)">{{ platform.watch_note | safe }}</p>
    </div>
</section>

<!-- KARŞILAŞTIRMA -->
<section class="section section--subtle" id="karsilastirma">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">{{ compare.eyebrow }}</span>
            <h2>{{ compare.head }}</h2>
        </div>
        <div class="disclosure" style="margin-block-end:var(--sp-6)">{{ compare.disclosure }}</div>
        <div class="table-scroll">
            <table class="table">
                <caption class="sr-only">{{ compare.caption }}</caption>
                <thead><tr>
                    <th scope="col">{{ compare.col_feature }}</th>
                    <th scope="col" class="col-suu">Suu</th>
{%- for c in compare.competitors %}
                    <th scope="col">{{ c }}</th>
{%- endfor %}
                </tr></thead>
                <tbody>
{%- for r in compare.rows %}
                    <tr><td>{{ r.label }}</td><td class="col-suu {{ r.suu_class }}">{{ r.suu }}</td>{% for v in r.others %}<td class="{{ v.cls }}">{{ v.text }}</td>{% endfor %}</tr>
{%- endfor %}
                </tbody>
            </table>
        </div>
        <div class="verdict" style="margin-block-start:var(--sp-8)">
            <h3>{{ compare.verdict_head }}</h3>
            <p><strong>{{ compare.rivals_label }}</strong> {{ compare.rivals }}</p>
            <p><strong>{{ compare.suu_label }}</strong> {{ compare.suu_edge | safe }}</p>
            <p style="margin-block-start:var(--sp-4)">{{ compare.links | safe }}</p>
        </div>
    </div>
</section>

<!-- PUANLAR -->
{#- Yorum kartları yalnızca doğrulanabilir, atfı olan yorumlar girildiğinde basılır.
    reviews['items'] boşsa mağaza listelerine yönlendiren doğrulanabilir bir blok çıkar.
    Kaynağı belirsiz yorum metni bu bölüme ASLA eklenmez. #}
<section class="section" id="yorumlar">
    <div class="container">
        <div class="section-head">
            <h2>{{ reviews.head }}</h2>
            <p>{{ reviews.sub }}</p>
        </div>
{%- if reviews['items'] %}
        <div class="cards">
{%- for r in reviews['items'] %}
            <article class="card">
                <p class="small" style="color:var(--accent-gold);margin-block-end:var(--sp-2)" aria-label="{{ reviews.stars_aria | replace('{n}', r.stars | string) }}">{{ '★' * r.stars }}{{ '☆' * (5 - r.stars) }}</p>
                <p>&ldquo;{{ r.text }}&rdquo;</p>
                <p class="small text-subtle" style="margin-block-start:var(--sp-3)">— {{ r.author }}{% if r.source %} · <a href="{{ r.source_url }}" rel="nofollow">{{ r.source }}</a>{% endif %}</p>
            </article>
{%- endfor %}
        </div>
{%- else %}
        <div class="btn-row btn-row--center">
            <a class="btn btn--secondary" href="{{ facts.links.google_play }}" rel="nofollow noopener" target="_blank">{{ reviews.cta_play }}</a>
            <a class="btn btn--secondary" href="{{ facts.links.app_store }}" rel="nofollow noopener" target="_blank">{{ reviews.cta_appstore }}</a>
        </div>
{%- endif %}
    </div>
</section>

<!-- FİYATLANDIRMA -->
<section class="section section--subtle" id="fiyat" data-cta="fiyat">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">{{ pricing.eyebrow }}</span>
            <h2>{{ pricing.head }}</h2>
            <p>{{ pricing.sub }}</p>
        </div>
        <div class="plans">
{%- for p in pricing.plans %}
            <article class="plan{% if p.get('featured') %} plan--featured{% endif %}">
{%- if p.get('badge') %}
                <span class="plan__badge">{{ p.badge }}</span>
{%- endif %}
                <h3>{{ p.name }}</h3>
                <div class="plan__price">{{ p.price }}{% if p.get('was') %} <span class="plan__was">{{ p.was }}</span>{% endif %}{% if p.get('period') %} <span class="plan__period">{{ p.period }}</span>{% endif %}</div>
                <p class="small text-subtle">{{ p.note }}</p>
                <ul class="plan__list">
{%- for f in p.features %}
                    <li>{{ f }}</li>
{%- endfor %}
                </ul>
                <a href="{{ p.href }}" class="btn {{ 'btn--primary' if p.get('featured') else 'btn--ghost' }} btn--block">{{ p.cta }}</a>
            </article>
{%- endfor %}
        </div>
    </div>
</section>

<!-- SSS -->
<section class="section" id="sss">
    <div class="container">
        <div class="section-head"><h2>{{ faq.head }}</h2></div>
        <div class="faq">
{%- for item in faq['items'] %}
            <details class="faq__item"{% if loop.first %} open{% endif %}>
                <summary>{{ item.q }}</summary>
                <div><p>{{ item.a }}{% if item.get('link') %} <a href="{{ item.link.href }}">{{ item.link.label }} <span class="arrow" aria-hidden="true">→</span></a>{% endif %}</p></div>
            </details>
{%- endfor %}
        </div>
        <p class="small text-subtle text-center" style="margin-block-start:var(--sp-8);max-width:44rem;margin-inline:auto">{{ disclaimer }}</p>
    </div>
</section>

<!-- KAPANIŞ CTA -->
<section class="cta-band" data-cta="kapanis">
    <div class="container">
        <h2>{{ cta.head }}</h2>
        <p class="lead" style="max-width:34rem;margin-inline:auto">{{ cta.sub }}</p>
        <div style="margin-block-start:var(--sp-8)">{{ store_buttons('kapanis') }}</div>
    </div>
</section>

</main>

<footer class="footer">
    <div class="container">
        <div class="footer__grid">
            <div>
                <a href="{{ links.home }}" class="nav__logo" style="margin-block-end:var(--sp-3)">
                    <svg width="24" height="24" aria-hidden="true"><use href="#i-water"></use></svg> Suu
                </a>
                <p class="small">{{ footer.blurb }}</p>
            </div>
{%- for col in footer.columns %}
            <div>
                <h4>{{ col.title }}</h4>
                <ul>
{%- for l in col.links %}
                    <li><a href="{{ l.href }}">{{ l.label }}</a></li>
{%- endfor %}
                </ul>
            </div>
{%- endfor %}
        </div>
        <nav class="footer__langs" aria-label="{{ footer.langs_label }}">
{%- for l in footer_langs %}
            <a href="{{ l.href }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == lang %} aria-current="page"{% endif %}>{{ l.name }}</a>
{%- endfor %}
        </nav>
        <div class="footer__bottom">
            <p class="small mb-0">© 2026 Suu · Furkan Mert Fındıklı</p>
            <p class="small mb-0"><a href="mailto:{{ facts.links.support_email }}">{{ facts.links.support_email }}</a></p>
        </div>
    </div>
</footer>

<div class="sticky-cta" data-cta="sticky">
    <a href="/app?src=sticky" class="btn btn--secondary">App Store</a>
    <a href="/app?src=sticky" class="btn btn--primary">Google Play</a>
</div>

<script>
(function () {
    var nav = document.getElementById('nav');
    var toggle = document.getElementById('navToggle');
    if (!nav || !toggle) return;
    var openLabel = {{ nav.menu_open | tojson }}, closeLabel = {{ nav.menu_close | tojson }};
    toggle.addEventListener('click', function () {
        var open = nav.getAttribute('data-open') === 'true';
        nav.setAttribute('data-open', open ? 'false' : 'true');
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        toggle.setAttribute('aria-label', open ? openLabel : closeLabel);
    });
    nav.addEventListener('click', function (e) {
        if (e.target.closest('.nav__links a')) {
            nav.setAttribute('data-open', 'false');
            toggle.setAttribute('aria-expanded', 'false');
        }
    });
})();
</script>

</body>
</html>
