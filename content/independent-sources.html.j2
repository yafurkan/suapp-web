<!DOCTYPE html>
<html lang="{{ lang }}"{% if dir == 'rtl' %} dir="rtl"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>(function(){try{var t=localStorage.getItem('suu-theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}})();</script>

    <!-- ÜRETİLMİŞ DOSYA — elle düzenlemeyin.
         Kaynak: content/independent-sources.json + content/independent-sources.html.j2
         Yeniden üret: python3 scripts/build-independent-sources.py --apply -->

    <title>{{ spec.meta.title }}</title>
    <meta name="description" content="{{ spec.meta.description }}">
    <meta name="keywords" content="{{ spec.meta.keywords }}">
    <meta name="apple-itunes-app" content="app-id={{ facts.links.app_store_id }}">

    <link rel="canonical" href="{{ url }}">
    {#- inject-hreflang.py'nin yazdığı biçimle birebir aynı (yorum + sondaki boş satır). #}
    <!-- Hreflang cluster (auto-injected) -->
{%- for h in hreflang %}
    <link rel="alternate" hreflang="{{ h.code }}" href="{{ h.href }}">
{%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ xdefault_href }}">


    <meta property="og:title" content="{{ spec.meta.og_title }}">
    <meta property="og:description" content="{{ spec.meta.og_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://suuapp.com/assets/og-image.png">
    <meta property="og:site_name" content="Suu">
    <meta property="og:locale" content="{{ locale }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ facts.links.twitter_handle }}">
    <meta name="twitter:title" content="{{ spec.meta.og_title }}">
    <meta name="twitter:description" content="{{ spec.meta.og_description }}">
    <meta name="twitter:image" content="https://suuapp.com/assets/og-image.png">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/donation-widget.css?v=6">
    <link rel="stylesheet" href="/assets/css/suu.css">
    <style>
        .src-card h3 a::after { content: " ↗"; font-weight: 400; opacity: .6; }
        .src-card .src-meta { margin: 0; font-size: var(--fs-sm); opacity: .75; }
        .src-empty { border: 1px dashed currentColor; border-radius: 14px; padding: var(--sp-5); opacity: .85; }
    </style>

    <script type="application/ld+json">
{{ jsonld | safe }}
    </script>

    <script src="/assets/js/analytics.js" defer></script>
    <script src="/lang-switcher.js?v=3" defer></script>
    <script src="/assets/js/theme.js?v=1" defer></script>
    <script src="/donation-widget.js?v=6" defer></script>
</head>
<body>

<a class="skip-link" href="#main">{{ ui.skip }}</a>

<nav class="nav">
    <div class="container nav__inner">
        <a href="{{ ui.home_href }}" class="nav__logo"><img src="/assets/brand/suu-badge-128.png" alt="Suu" width="128" height="128" class="suu-logo-badge" style="height:1.6em;width:1.6em;border-radius:50%;vertical-align:-0.4em;box-shadow:0 0 0 1px rgba(255,255,255,.12),0 0 14px rgba(94,170,255,.45);"> Suu</a>
        <ul class="nav__links">
            <li><a href="{{ ui.blog_href }}">{{ ui.blog }}</a></li>
{%- if ui.get('glossary_href') %}
            <li><a href="{{ ui.glossary_href }}">{{ ui.glossary_label }}</a></li>
{%- endif %}
            <li><a href="{{ ui.home_href }}#fiyat">{{ ui.pricing }}</a></li>
        </ul>
        <div class="nav__actions">
            <a href="/app?src=sources-nav" class="btn btn--primary" data-cta="nav"
               style="min-height:40px;padding:var(--sp-2) var(--sp-5);font-size:var(--fs-sm)">{{ ui.cta }}</a>
        </div>
    </div>
</nav>

<main id="main">

<header class="section" style="padding-block-end:var(--sp-8)">
    <div class="container container--narrow">
        <span class="badge badge--new">{{ spec.badge }}</span>
        <h1 style="margin-block-start:var(--sp-4)">{{ spec.h1 }}</h1>
        <p class="small text-subtle">{{ spec.checked_label }}: {{ checked_display }} · {{ total }} {{ spec.sources_word }}</p>
    </div>
</header>

<div class="container container--narrow stack--lg" style="padding-block-end:var(--sp-12)">

    <!-- CEVAP-ÖNCE: alıntılanan blok burasıdır -->
    <div class="answer-box">
        <p>{{ spec.answer }}</p>
    </div>

{%- for p in spec.intro %}
    <p>{{ p | safe }}</p>
{%- endfor %}

    <div class="disclosure">{{ spec.disclosure }}</div>

</div>

{%- for group in groups %}
<section class="section{% if loop.index is even %} section--subtle{% endif %}" id="{{ group.id }}">
    <div class="container">
        <div class="section-head">
            <h2>{{ group.title }}</h2>
            <p>{{ group.blurb }}</p>
        </div>
{%- if group.entries %}
        <div class="cards">
{%- for item in group.entries %}
            <article class="card hub-card hub-card--neutral src-card">
{%- if item.get('press') %}
                <h3><a href="{{ item.url }}" rel="noopener"{% if item.lang %} hreflang="{{ item.lang }}"{% endif %}>{{ item.name }}</a></h3>
                <p class="src-meta">{{ item.outlet }} · <time datetime="{{ item.date }}">{{ item.date_display }}</time>{% if item.own %} · {{ spec.own_label }}{% endif %}</p>
{%- else %}
                <h3><a href="{{ item.url }}" rel="noopener">{{ item.name }}</a></h3>
                <p>{{ item.desc }}</p>
{%- endif %}
            </article>
{%- endfor %}
        </div>
{%- else %}
        <div class="container--narrow src-empty">
            <p>{{ group.empty }}</p>
            <p class="mb-0">{{ spec.press_cta }} <a href="{{ press_href }}">{{ spec.press_cta_link }}</a></p>
        </div>
{%- endif %}
    </div>
</section>
{%- endfor %}

<section class="cta-band" data-cta="kapanis">
    <div class="container">
        <h2>{{ ui.cta_head }}</h2>
        <p class="lead" style="max-width:34rem;margin-inline:auto">{{ ui.cta_sub }}</p>
        <div style="margin-block-start:var(--sp-8);display:flex;gap:var(--sp-3);justify-content:center;flex-wrap:wrap">
            <a href="/app?src=sources-kapanis" class="btn btn--secondary" data-cta="kapanis">App Store</a>
            <a href="/app?src=sources-kapanis" class="btn btn--primary" data-cta="kapanis">Google Play</a>
        </div>
    </div>
</section>

</main>

<footer class="footer">
    <div class="container">
        <nav class="footer__langs" aria-label="{{ ui.langs_label }}">
{%- for l in footer_langs %}
            <a href="{{ l.href }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == lang %} aria-current="page"{% endif %}>{{ l.name }}</a>
{%- endfor %}
        </nav>
        <div class="footer__bottom">
            <p class="small mb-0">© 2026 Suu · {{ facts.entities.founder.name }}</p>
            <p class="small mb-0"><a href="{{ ui.home_href }}">suuapp.com</a></p>
        </div>
    </div>
</footer>

<div class="sticky-cta" data-cta="sticky">
    <a href="/app?src=sticky" class="btn btn--secondary">App Store</a>
    <a href="/app?src=sticky" class="btn btn--primary">Google Play</a>
</div>

<script src="/assets/js/suu-badge.js?v=2" defer></script>
</body>
</html>
